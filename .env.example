# OANDA. Use practice first.
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=
OANDA_API_KEY=
OANDA_ENV=practice

# Safe defaults. Switch these only after paper validation.
EXECUTION_MODE=paper
PAPER_TRADE=true
LIVE_TRADING_ENABLED=false
PAPER_BALANCE=10000

# Telegram alerts and commands.
INDICES_TELEGRAM_TOKEN=
INDICES_TELEGRAM_CHAT_ID=
INDICES_TELEGRAM_POLL_SECONDS=5
INDICES_TELEGRAM_HEARTBEAT_MINUTES=60
INDICES_STARTUP_MESSAGE_COOLDOWN_MINUTES=30

# Optional Redis state sharing.
REDIS_URL=
INDICES_RUNTIME_STATE_KEY=indices_runtime_state
INDICES_BOT_STATUS_KEY=indices_bot_runtime_status
INDICES_MACRO_STATE_KEY=indices_macro_state
INDICES_CALIBRATION_KEY=indices_calibration
INDICES_DAILY_REVIEW_KEY=bot_assessor:indices:daily_review
INDICES_OVERLAY_KEY=bot_assessor:indices:overlays

# Universe and cadence.
INDICES_UNIVERSE=SPX500,NAS100,US30,UK100,DE40,EU50,FR40,JP225,HK33,AU200
SCAN_INTERVAL_SECONDS=300
INDICES_HEARTBEAT_SECONDS=3600
RUN_ONCE=false

# Risk controls.
INDICES_BUDGET_ALLOCATION=1.00
MAX_RISK_PER_TRADE=0.003
MAX_TOTAL_INDICES_RISK=0.012
MAX_OPEN_INDICES_TRADES=3
MAX_OPEN_PER_REGION=2
MAX_OPEN_PER_SYMBOL=1
MAX_LIVE_ORDERS_PER_SCAN=1
MAX_MARGIN_PER_ENTRY_PCT=0.08
MIN_MARGIN_PER_ENTRY_PCT=0.02
INDICES_MIN_UNIT_FLOOR_ENABLED=false
INDICES_MIN_UNIT_FLOOR_MAX_RISK_NAV_PCT=0.001
INDICES_MIN_UNIT_FLOOR_SMALL_ACCOUNT_MAX_RISK_NAV_PCT=0.06
INDICES_MIN_UNIT_FLOOR_SMALL_ACCOUNT_MAX_TOTAL_RISK_NAV_PCT=0.10
INDICES_MIN_UNIT_FLOOR_SMALL_ACCOUNT_MAX_MARGIN_NAV_PCT=0.60
INDICES_MIN_UNIT_FLOOR_MAX_TARGET_RISK_MULTIPLE=12
DAILY_LOSS_HALT_PCT=0.015
ROLLING_DD_THROTTLE_PCT=0.05
ROLLING_DD_HALT_PCT=0.10

# Signal / hold-time filters (calibrated defaults from 30d backtest).
INDICES_ENABLED_STRATEGIES=TREND_PULLBACK,OPENING_RANGE_BREAKOUT
INDICES_DISABLED_STRATEGY_LANES=SPX500:OPENING_RANGE_BREAKOUT:SHORT,US30:OPENING_RANGE_BREAKOUT:SHORT
INDICES_REQUIRE_CALIBRATION=true
INDICES_CALIBRATION_MIN_TRADES=30
INDICES_CALIBRATION_MIN_GROUPS=1
INDICES_MIN_SCORE=78
INDICES_MAX_HOLD_BARS=12
INDICES_BAR_MINUTES=15
INDICES_NO_PROGRESS_EXIT_ENABLED=true
INDICES_NO_PROGRESS_MIN_BARS=8
INDICES_NO_PROGRESS_MIN_PEAK_R=0.08
INDICES_NO_PROGRESS_LOSS_R=0.35
INDICES_US_HOLIDAY_ORB_BLOCK_ENABLED=true
INDICES_SAME_LANE_STOP_COOLDOWN_MINUTES=90

# News and regime controls.
NEWS_ENABLED=true
MACRO_REFRESH_SECONDS=300
MACRO_STATE_MAX_AGE_MINUTES=30
PRE_EVENT_PAUSE_MINUTES=20
POST_EVENT_SETTLE_MINUTES=15
HIGH_IMPACT_WINDOW_MINUTES=180
RISK_OFF_FILTER_ENABLED=true
RISK_ON_ENABLED_STRATEGIES=OPENING_RANGE_BREAKOUT

# Optional confirmed risk-off aggressive overlay. Keep disabled until backtested.
RISK_OFF_AGGRESSIVE_ENABLED=false
RISK_OFF_AGGRESSIVE_ENABLED_STRATEGIES=EVENT_MOMENTUM,OPENING_RANGE_BREAKOUT
RISK_OFF_AGGRESSIVE_MIN_SCORE=73
RISK_OFF_AGGRESSIVE_SHORT_SCORE_BONUS=4
RISK_OFF_AGGRESSIVE_LONG_SCORE_PENALTY=6
RISK_OFF_AGGRESSIVE_RISK_MULTIPLIER=1.5
RISK_OFF_AGGRESSIVE_MAX_ENTRY_SPREAD_ATR=0.14
RISK_OFF_AGGRESSIVE_PROFIT_LOCK_TRIGGER_PCT=6
RISK_OFF_AGGRESSIVE_PROFIT_LOCK_PULLBACK_PCT=1.8
RISK_OFF_AGGRESSIVE_VIX_LEVEL=25
RISK_OFF_AGGRESSIVE_VIX_CHANGE_PCT=8

# Backtesting and calibration.
BACKTEST_DAYS=30
BACKTEST_GRANULARITY=M15
BACKTEST_OUTPUT_DIR=backtest_output
BACKTEST_INITIAL_BALANCE=10000
